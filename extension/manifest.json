{
  "manifest_version": 3,
  "name": "Cinema Guard",
  "version": "1.0.0",
  "description": "Mutes swearing in YouTube videos as it happens, using their captions. Your own word list; also works on other sites.",
  "homepage_url": "https://github.com/nieuwoudtza/Cinema-Guard",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Cinema Guard",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": [
        "shared/catalog.js",
        "shared/matcher.js",
        "shared/settings.js",
        "shared/captions.js",
        "shared/hits.js",
        "page/hooks.js",
        "page/sites.js",
        "page/engine.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-filtering": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Turn filtering on or off"
    }
  }
}
