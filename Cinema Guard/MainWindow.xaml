<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cinema_Guard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cinema_Guard"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    Title="Cinema Guard">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="48,*">
        <Grid x:Name="TitleBar" Grid.Row="0" Padding="18,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" />
                <TextBlock Text="Cinema Guard" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Version}" Style="{StaticResource MutedStyle}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="208"
            CompactPaneLength="48"
            AlwaysShowHeader="False"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="Nav_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Queue" Tag="queue">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Filter" Tag="filter">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Models" Tag="models">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE720;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tools" Tag="tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid RowDefinitions="Auto,Auto,*">
                <InfoBar
                    Margin="24,8,24,0"
                    Title="Update ready"
                    Severity="Informational"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsUpdateReady, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            Content="Restart now"
                            Click="RestartToUpdate_Click"
                            IsEnabled="{x:Bind ViewModel.CanRestartToUpdate, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <!-- Phonon is set to the GPU but its image is missing (first install, or an update moved it on). -->
                <InfoBar
                    Grid.Row="1"
                    Margin="24,8,24,0"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsGpuNoticeOpen, Mode=TwoWay}"
                    Title="{x:Bind ViewModel.GpuNoticeTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.GpuNoticeMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.GpuNoticeSeverity, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            Content="Download"
                            Click="DownloadGpuImage_Click"
                            Visibility="{x:Bind ViewModel.CanDownloadGpuImage, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <Frame x:Name="ContentFrame" Grid.Row="2" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
