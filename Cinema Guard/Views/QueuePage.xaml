<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cinema_Guard.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cinema_Guard.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    Background="Transparent"
    AllowDrop="True"
    DragOver="Root_DragOver"
    Drop="Root_Drop">

    <Grid Padding="24,14,24,12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Title + primary action -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Spacing="2">
                <TextBlock Text="Queue" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.QueueSummaryText, Mode=OneWay}" Style="{StaticResource MutedStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- The speech model the next run uses; opens the Models page. -->
                <Button
                    Click="SpeechModel_Click"
                    CornerRadius="14"
                    Padding="10,4"
                    AutomationProperties.Name="Speech model"
                    ToolTipService.ToolTip="The speech model that listens to the films. Click to change it.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE720;" FontSize="13" />
                        <TextBlock Text="{x:Bind ViewModel.SpeechSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Start_Click"
                    AutomationProperties.Name="Censor"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Censor" />
                    </StackPanel>
                </Button>

                <Button
                    Click="Stop_Click"
                    AutomationProperties.Name="Stop"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Secondary actions: add files, then the three ways to get subtitles. Scrolls when the window is narrow. -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,12"
            HorizontalScrollMode="Auto"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Style="{StaticResource TransparentButtonStyle}" Click="AddFiles_Click" AutomationProperties.Name="Add files">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Add files" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TransparentButtonStyle}" Click="AddFolder_Click" AutomationProperties.Name="Add folder">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="Add folder" />
                    </StackPanel>
                </Button>

                <Border Width="1" Height="20" Margin="6,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <SplitButton
                    x:Name="GenerateButton"
                    Content="Generate subtitles"
                    Click="GenerateSplit_Click"
                    ToolTipService.ToolTip="Tick Generate subtitles on the selected files (or every file when none are selected). The speech model then transcribes their dialogue when you press Censor.">
                    <SplitButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="All files" Click="GenerateAll_Click" />
                            <MenuFlyoutItem Text="Files without any subtitles" Click="GenerateMissing_Click" />
                            <MenuFlyoutItem Text="None" Click="GenerateNone_Click" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>

                <Button
                    x:Name="ExtractButton"
                    Style="{StaticResource TransparentButtonStyle}"
                    Click="Extract_Click"
                    AutomationProperties.Name="Extract subtitles"
                    ToolTipService.ToolTip="Copy the subtitle track inside the video to an .srt file beside it. Works on the selected files, or every file when none are selected.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        <TextBlock Text="Extract subtitles" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="DownloadButton"
                    Style="{StaticResource TransparentButtonStyle}"
                    Click="Download_Click"
                    AutomationProperties.Name="Download subtitles"
                    ToolTipService.ToolTip="Download subtitles from OpenSubtitles to an .srt file beside the video. Works on the selected files, or every file when none are selected.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock Text="Download subtitles" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Selection: which rows the actions above work on, and removing rows. -->
        <Grid
            Grid.Row="3"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="8"
            Margin="0,0,0,8"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource TransparentButtonStyle}" Click="SelectAll_Click" Content="Select all" ToolTipService.ToolTip="Select every file (Ctrl+A)" />
                <Button Style="{StaticResource TransparentButtonStyle}" Click="SelectNone_Click" Content="Select none" />
                <Button Style="{StaticResource TransparentButtonStyle}" Click="InvertSelection_Click" Content="Invert selection" />
            </StackPanel>

            <TextBlock
                x:Name="SelectionText"
                Grid.Column="1"
                Style="{StaticResource MutedStyle}"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Margin="8,0,0,0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                <Button
                    x:Name="RemoveSelectedButton"
                    Style="{StaticResource TransparentButtonStyle}"
                    Click="Remove_Click"
                    IsEnabled="False"
                    AutomationProperties.Name="Remove selected"
                    ToolTipService.ToolTip="Take the selected files off the queue (Delete). The files on disk are not touched.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Remove selected" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="ClearButton"
                    Style="{StaticResource TransparentButtonStyle}"
                    Click="Clear_Click"
                    AutomationProperties.Name="Clear the queue"
                    ToolTipService.ToolTip="Take every file off the queue. The files on disk are not touched.">
                    <TextBlock Text="Clear all" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="2"
            Margin="0,0,0,8"
            IsOpen="{x:Bind ViewModel.IsSummaryOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.SummaryTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.SummaryMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.SummarySeverity, Mode=OneWay}"
            IsClosable="True" />

        <!-- Queue: the tick boxes on the left are the selection; Generate subtitles is labelled on each row. -->
        <Grid Grid.Row="4">
            <ListView
                x:Name="MediaList"
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectionMode="Multiple"
                IsMultiSelectCheckBoxEnabled="False"
                SelectionChanged="MediaList_SelectionChanged"
                ContextRequested="MediaList_ContextRequested"
                IsItemClickEnabled="False"
                AllowDrop="True"
                DragOver="Root_DragOver"
                Drop="Root_Drop"
                KeyDown="MediaList_KeyDown"
                Margin="-8,0,-8,0">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ContextFlyout>
                    <!-- Works on the row right-clicked (or the selection, when that row is in it).
                         Items tagged "idle" change the queue, so they are hidden while it runs. -->
                    <MenuFlyout Opening="ContextMenu_Opening">
                        <MenuFlyoutItem Text="Peek" Click="PeekMenu_Click" />
                        <MenuFlyoutItem Text="Language report" Click="LanguageReport_Click" />
                        <MenuFlyoutSeparator Tag="idle" />
                        <MenuFlyoutItem Tag="idle" Text="Extract subtitles" Click="ExtractMenu_Click" />
                        <MenuFlyoutItem Tag="idle" Text="Download subtitles" Click="DownloadMenu_Click" />
                        <MenuFlyoutItem Tag="idle" Text="Generate subtitles" Click="GenerateMenu_Click" />
                        <MenuFlyoutItem Tag="idle" Text="Select subtitles…" Click="SelectSubtitles_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Open folder" Click="OpenFolder_Click" />
                        <MenuFlyoutItem Tag="idle" Text="Remove" Click="RemoveMenu_Click" />
                    </MenuFlyout>
                </ListView.ContextFlyout>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MediaItemViewModel">
                        <Grid Padding="8,2">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                                    <!-- The selection, inside the card where it is easy to see (the ListView's own box is off). -->
                                    <CheckBox
                                        Grid.Column="0"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                        Click="SelectBox_Click"
                                        AutomationProperties.Name="Select this file"
                                        ToolTipService.ToolTip="Select this file" />

                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{x:Bind FileName}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind FullPath}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="{x:Bind SourceBadge, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            </Border>
                                            <TextBlock
                                                Text="{x:Bind Status, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{x:Bind Detail, Mode=OneWay}"
                                                Style="{StaticResource MutedStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                MaxWidth="460"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{x:Bind DetailToolTip, Mode=OneWay}" />
                                        </StackPanel>

                                        <ProgressBar
                                            Value="{x:Bind Progress, Mode=OneWay}"
                                            Maximum="100"
                                            Height="3"
                                            Margin="0,2,0,0"
                                            IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                            Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" />
                                    </StackPanel>

                                    <CheckBox
                                        Grid.Column="2"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        Content="Generate subtitles"
                                        IsChecked="{x:Bind GenerateSubtitles, Mode=TwoWay}"
                                        ToolTipService.ToolTip="Transcribe this file's dialogue with the speech model when you press Censor. Off: use the subtitles it already has." />

                                    <Button
                                        Grid.Column="3"
                                        Style="{StaticResource TransparentButtonStyle}"
                                        Click="Peek_Click"
                                        AutomationProperties.Name="{x:Bind HitText, Mode=OneWay}"
                                        Visibility="{x:Bind HitsVisibility, Mode=OneWay}"
                                        ToolTipService.ToolTip="Show the filtered words">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                                            <TextBlock Text="{x:Bind HitText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Button>

                                    <FontIcon
                                        Grid.Column="4"
                                        Glyph="{x:Bind ResultGlyph, Mode=OneWay}"
                                        Foreground="{x:Bind ResultBrush, Mode=OneWay}"
                                        FontSize="16"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE714;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Drop video files here" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="MKV, MP4, AVI, M4V, MOV, WEBM, TS · or use Add files."
                    Style="{StaticResource MutedStyle}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="0,12,0,0" RowDefinitions="Auto,Auto">
            <ProgressBar Value="{x:Bind ViewModel.OverallProgress, Mode=OneWay}" Maximum="100" Height="3" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    Style="{StaticResource MutedStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}"
                    Style="{StaticResource MutedStyle}"
                    Margin="12,0,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Page>
