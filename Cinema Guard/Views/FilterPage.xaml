<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cinema_Guard.Views.FilterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    Background="Transparent">

    <Grid Padding="24,14,24,0" RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
            <TextBlock Text="Filter" Style="{StaticResource PageTitleStyle}" />
            <TextBlock
                Text="A family toggles every spelling of a word. Sentence words mute the whole line; single words mute only the word itself."
                Style="{StaticResource MutedStyle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Padding="0,0,0,16" MaxWidth="1100" HorizontalAlignment="Left">

                <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Mute the whole sentence" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Blasphemy and insults: the entire line is silenced." Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                        <Button Content="Select all / none" Click="ToggleAllFull_Click" HorizontalAlignment="Left" />
                        <StackPanel x:Name="FullWordsPanel" Spacing="0" />
                        <TextBlock Text="Additional words or phrases (one per line)" Style="{StaticResource MutedStyle}" Margin="0,10,0,0" />
                        <TextBox
                            x:Name="FullCustom"
                            AcceptsReturn="True"
                            Height="96"
                            TextWrapping="Wrap"
                            PlaceholderText="One per line"
                            FontFamily="Consolas" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Mute the word only" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Everyday swearing: only the spoken word is silenced." Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                        <Button Content="Select all / none" Click="ToggleAllSingle_Click" HorizontalAlignment="Left" />
                        <StackPanel x:Name="SingleWordsPanel" Spacing="0" />
                        <TextBlock Text="Additional words or phrases (one per line)" Style="{StaticResource MutedStyle}" Margin="0,10,0,0" />
                        <TextBox
                            x:Name="SingleCustom"
                            AcceptsReturn="True"
                            Height="96"
                            TextWrapping="Wrap"
                            PlaceholderText="One per line, e.g. HOLY SHIT"
                            FontFamily="Consolas" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="0,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="Status" Style="{StaticResource MutedStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
            </Grid>
        </Border>
    </Grid>
</Page>
