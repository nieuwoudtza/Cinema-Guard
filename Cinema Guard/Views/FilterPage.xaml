<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cinema_Guard.Views.FilterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    Background="Transparent">

    <Grid Padding="24,14,24,0" RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="Filter" Style="{StaticResource PageTitleStyle}" />
            <TextBlock
                Text="A family toggles every spelling of a word; the count beside it opens the family to turn single spellings on or off. Sentence words mute the whole line; single words mute only the word itself."
                Style="{StaticResource MutedStyle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <!-- Top so the cards end with their lists, not at the bottom of the window. -->
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource PageContentMaxWidth}" />
                </Grid.ColumnDefinitions>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Padding="0,0,4,16">

                    <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Mute the whole sentence" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Blasphemy and insults: the entire line is silenced." Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                            <Button Content="Select all / none" Click="ToggleAllFull_Click" HorizontalAlignment="Left" ToolTipService.ToolTip="Tick every word on this list, or untick them all when they are all ticked" />
                            <StackPanel x:Name="FullWordsPanel" Spacing="0" />
                            <TextBlock Text="Additional words or phrases (one per line)" Style="{StaticResource MutedStyle}" Margin="0,10,0,0" />
                            <TextBox
                                x:Name="FullCustom"
                                AcceptsReturn="True"
                                Height="96"
                                TextWrapping="Wrap"
                                PlaceholderText="One per line"
                                FontFamily="Consolas" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Mute the word only" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Everyday swearing: only the spoken word is silenced." Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                            <Button Content="Select all / none" Click="ToggleAllSingle_Click" HorizontalAlignment="Left" ToolTipService.ToolTip="Tick every word on this list, or untick them all when they are all ticked" />
                            <StackPanel x:Name="SingleWordsPanel" Spacing="0" />
                            <TextBlock Text="Additional words or phrases (one per line)" Style="{StaticResource MutedStyle}" Margin="0,10,0,0" />
                            <TextBox
                                x:Name="SingleCustom"
                                AcceptsReturn="True"
                                Height="96"
                                TextWrapping="Wrap"
                                PlaceholderText="One per line, e.g. HOLY SHIT"
                                FontFamily="Consolas" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="0,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="Status" Style="{StaticResource MutedStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" ToolTipService.ToolTip="Keep these words for the next films you censor" />
            </Grid>
        </Border>
    </Grid>
</Page>
