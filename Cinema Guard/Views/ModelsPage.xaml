<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cinema_Guard.Views.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Cinema_Guard.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="ModelRowTemplate" x:DataType="vm:ModelRowViewModel">
            <Grid
                Padding="14,10"
                ColumnDefinitions="Auto,*,Auto,Auto"
                ColumnSpacing="12"
                Background="Transparent"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Visibility="{x:Bind IsVisible, Mode=OneWay}"
                Tapped="Row_Tapped">

                <!-- The whole row is clickable; the radio is the keyboard and screen-reader way in. -->
                <RadioButton
                    MinWidth="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Name}"
                    Click="Radio_Click" />

                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                        <Border
                            Padding="7,0,7,1"
                            CornerRadius="9"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            Visibility="{x:Bind IsSelected, Mode=OneWay}">
                            <TextBlock Text="In use" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Border>
                        <Border
                            Padding="7,0,7,1"
                            CornerRadius="9"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            Visibility="{x:Bind IsRecommended, Mode=OneWay}">
                            <TextBlock Text="Recommended" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ComboBox
                        MinWidth="170"
                        ItemsSource="{x:Bind VariantLabels}"
                        SelectedIndex="{x:Bind VariantIndex, Mode=TwoWay}"
                        Visibility="{x:Bind HasVariants}"
                        ToolTipService.ToolTip="Which build of the model to use" />
                    <ToggleSwitch
                        MinWidth="0"
                        OffContent="CPU"
                        OnContent="GPU"
                        IsOn="{x:Bind UseGpu, Mode=TwoWay}"
                        Visibility="{x:Bind ShowGpuSwitch, Mode=OneWay}"
                        ToolTipService.ToolTip="Run on the graphics card" />
                </StackPanel>

                <StackPanel Grid.Column="3" MinWidth="150" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsDownloading, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind StateText, Mode=OneWay}">
                        <ProgressBar Width="80" VerticalAlignment="Center" Value="{x:Bind Progress, Mode=OneWay}" IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="32" />
                        <Button Style="{StaticResource TransparentButtonStyle}" Padding="6,4" Click="Cancel_Click" AutomationProperties.Name="Cancel download" ToolTipService.ToolTip="Cancel the download">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind HasStateText, Mode=OneWay}">
                        <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind StateText, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Content="Download" Click="Download_Click" Visibility="{x:Bind ShowDownload, Mode=OneWay}" ToolTipService.ToolTip="Download this model once; it stays on this PC" />
                    <Button Content="Set up…" Click="SetUp_Click" Visibility="{x:Bind ShowSetUp, Mode=OneWay}" ToolTipService.ToolTip="Fill in the details this model needs before it can be used" />

                    <Button
                        Style="{StaticResource TransparentButtonStyle}"
                        Padding="6,4"
                        Click="Delete_Click"
                        AutomationProperties.Name="Delete model"
                        Visibility="{x:Bind ShowDelete, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind DeleteTip, Mode=OneWay}">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,14,24,12" RowDefinitions="Auto,*,Auto">

        <!-- Same column as the cards below, so the link ends where they do. -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource PageContentMaxWidth}" />
            </Grid.ColumnDefinitions>
            <Grid ColumnDefinitions="*,Auto" Padding="0,0,4,0">
                <StackPanel Spacing="2">
                    <TextBlock Text="Models" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Choose what listens to the audio of your films. Download or remove models here." Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <HyperlinkButton Grid.Column="1" Content="How do I choose?" Click="Guide_Click" VerticalAlignment="Bottom" />
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource PageContentMaxWidth}" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8" Padding="0,0,4,16">

                    <!-- This PC -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                            <FontIcon Glyph="&#xE7F8;" FontSize="16" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="This PC" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.HardwareText, Mode=OneWay}" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <!-- Until the first look at the disk is in, the rows below are disabled. -->
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.DiskText, Mode=OneWay}" Style="{StaticResource MutedStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="Open folder" Click="OpenFolder_Click" ToolTipService.ToolTip="Where the models are stored" />
                            <Button Grid.Column="4" Content="Re-detect" Click="Redetect_Click" ToolTipService.ToolTip="Check the graphics card and processor again (after a new card or driver)" />
                        </Grid>
                    </Border>

                    <SelectorBar x:Name="Filter" SelectionChanged="Filter_SelectionChanged" Margin="-4,2,0,0">
                        <SelectorBarItem Text="All" IsSelected="True" />
                        <SelectorBarItem Text="Downloaded" />
                        <SelectorBarItem Text="English" />
                        <SelectorBarItem Text="Multilingual" />
                    </SelectorBar>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sections}" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModelSection">
                                <StackPanel Spacing="0" Margin="0,8,0,0" Visibility="{x:Bind IsVisible, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}">
                                        <Run Text="{x:Bind Title}" />
                                        <Run Text="   " />
                                        <Run Text="{x:Bind Subtitle}" FontWeight="Normal" />
                                    </TextBlock>
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <!-- -1 hides the first row's divider under the card's rounded edge. -->
                                            <ItemsControl Margin="0,-1,0,0" ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource ModelRowTemplate}" />
                                            <HyperlinkButton
                                                Margin="44,0,0,4"
                                                Content="{x:Bind MoreText, Mode=OneWay}"
                                                Visibility="{x:Bind HasMore, Mode=OneWay}"
                                                Click="More_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Engines -->
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="2,8,0,0">
                        <Run Text="ENGINES" />
                        <Run Text="   " />
                        <Run Text="downloaded with the first model that needs them" FontWeight="Normal" />
                    </TextBlock>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <ItemsControl Margin="0,-1,0,0" ItemsSource="{x:Bind ViewModel.Engines}" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EngineRowViewModel">
                                    <Grid
                                        Padding="14,10"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12"
                                        BorderThickness="0,1,0,0"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" MinWidth="150" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsDownloading, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind StateText, Mode=OneWay}">
                                                <ProgressBar Width="80" VerticalAlignment="Center" Value="{x:Bind Progress, Mode=OneWay}" IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" VerticalAlignment="Center" MinWidth="32" />
                                                <Button Style="{StaticResource TransparentButtonStyle}" Padding="6,4" Click="EngineCancel_Click" AutomationProperties.Name="Cancel engine download" ToolTipService.ToolTip="Cancel the download">
                                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsInstalled, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="Installed" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Content="Download" Click="EngineDownload_Click" Visibility="{x:Bind ShowDownload, Mode=OneWay}" ToolTipService.ToolTip="Download this engine once; it stays on this PC" />
                                            <Button Style="{StaticResource TransparentButtonStyle}" Padding="6,4" Click="EngineDelete_Click" AutomationProperties.Name="Delete engine" Visibility="{x:Bind ShowDelete, Mode=OneWay}" ToolTipService.ToolTip="Delete">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <InfoBar
            Grid.Row="2"
            Margin="0,8,0,0"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" />
    </Grid>
</Page>
