<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cinema_Guard.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cinema_Guard.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    Background="Transparent">

    <Grid Padding="24,14,24,0" RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{x:Bind ViewModel.SettingsPath}" Style="{StaticResource MutedStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" Padding="0,0,4,20" MaxWidth="920" HorizontalAlignment="Left">

                <!-- ============================ VIDEO -->
                <TextBlock Text="VIDEO" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <controls:SettingRow Header="Container" Description="MP4 for compatibility. MKV is chosen automatically for TrueHD, DTS or Opus audio.">
                            <ComboBox MinWidth="130" SelectedIndex="{x:Bind ViewModel.ContainerIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="MP4" />
                                <ComboBoxItem Content="MKV" />
                            </ComboBox>
                        </controls:SettingRow>

                        <controls:SettingRow Header="File name affix" Description="Added before the extension: Movie_CG.mp4">
                            <TextBox Width="150" Text="{x:Bind ViewModel.S.CustomAffix, Mode=TwoWay}" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Change the aspect ratio" Description="Tag the output with a display aspect ratio.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.AspectRatio, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Aspect ratio" Description="Width : height">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox Width="92" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.AspectWidth, Mode=TwoWay}" />
                                <TextBlock Text=":" VerticalAlignment="Center" />
                                <NumberBox Width="92" Minimum="1" Maximum="100" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.AspectHeight, Mode=TwoWay}" />
                            </StackPanel>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <!-- ============================ SUBTITLES -->
                <TextBlock Text="SUBTITLES" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <controls:SettingRow Header="Create censored subtitles" Description="Write _Full and _Censored subtitle files, or embed them in the output.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.CreateSubtitles, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Subtitle output" Description="Full keeps every line (masked); Censored keeps only lines with filtered words; Dual writes both.">
                            <ComboBox MinWidth="150" SelectedIndex="{x:Bind ViewModel.SubtitleTypeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Full" />
                                <ComboBoxItem Content="Censored" />
                                <ComboBoxItem Content="Dual" />
                            </ComboBox>
                        </controls:SettingRow>

                        <controls:SettingRow Header="Embed in the video" Description="Embed the subtitle tracks instead of leaving .srt files next to the film.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.EmbedSubtitles, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Censor character" Description="One symbol, used to mask each letter of the word.">
                            <TextBox Width="64" MaxLength="1" Text="{x:Bind ViewModel.S.CensorCharacter, Mode=TwoWay}" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Retime subtitles to the transcript" Description="Fixes downloads timed for another frame rate (24.000 vs 23.976 is 6 seconds by the end of a film).">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.RetimeOutputSubtitles, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Also write one-word subtitles" Description="Legacy .oneword.srt file with one word per cue.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.WriteOneWordSrt, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Splice foreign-language cues" Description="Write a .mixed.srt that uses the multilingual transcript where the English model heard no English.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.SpliceForeignCues, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <!-- ============================ FILTER -->
                <TextBlock Text="FILTER" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <controls:SettingRow Header="Words" Description="{x:Bind ViewModel.FilterSummary, Mode=OneWay}">
                            <Button Content="Edit filter" Click="EditFilter_Click" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Padding for subtitle hits (ms)" Description="Before and after the estimated word time, when only the subtitle knows the word.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox Width="92" Minimum="0" Maximum="5000" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.EstimatedPadBefore, Mode=TwoWay}" />
                                <NumberBox Width="92" Minimum="0" Maximum="5000" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.EstimatedPadAfter, Mode=TwoWay}" />
                            </StackPanel>
                        </controls:SettingRow>

                        <controls:SettingRow Header="Padding for timed words (ms)" Description="Before and after the word timing from the speech model.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox Width="92" Minimum="0" Maximum="2000" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.WordPadBefore, Mode=TwoWay}" />
                                <NumberBox Width="92" Minimum="0" Maximum="2000" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.WordPadAfter, Mode=TwoWay}" />
                            </StackPanel>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <!-- ============================ TRANSCRIPTION -->
                <TextBlock Text="TRANSCRIPTION" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <controls:SettingRow Header="Speech model" Description="{x:Bind ViewModel.SpeechSummary, Mode=OneWay}">
                            <Button Content="Change…" Click="ChangeModel_Click" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Hotwords" Description="Names and terms the model tends to misspell, comma separated (max 25). Phonon and servers use them; Whisper takes them as a hint; Parakeet ignores them.">
                            <TextBox Width="360" Text="{x:Bind ViewModel.S.PhononHotwords, Mode=TwoWay}" PlaceholderText="optional" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Subtitle reading speed" Description="Characters per second ceiling for generated cues (21 is standard).">
                            <NumberBox Width="110" Minimum="8" Maximum="45" SmallChange="0.5" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.MaxCpsValue, Mode=TwoWay}" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Audio downmix for transcription" Description="Weight the centre channel where dialogue lives.">
                            <ComboBox MinWidth="160" SelectedIndex="{x:Bind ViewModel.DownmixIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Plain mono" />
                                <ComboBoxItem Content="Centre weighted" />
                            </ComboBox>
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <!-- ============================ PHONON ON THE GPU -->
                <TextBlock Text="PHONON ON THE GPU (DOCKER, OPTIONAL)" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <controls:SettingRow Header="Docker image" Description="Fermion's published CUDA image. Used when a Phonon model's switch on the Models page is set to GPU and Docker Desktop is installed.">
                            <TextBox Width="360" Text="{x:Bind ViewModel.S.DockerImage, Mode=TwoWay}" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Start Docker Desktop when needed" Description="Waits up to 90 seconds for Docker before falling back to the CPU.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.StartDockerDesktop, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Your own fermion.exe (advanced)" Description="Leave empty to use the Phonon engine from the Models page. A path here replaces it.">
                            <TextBox Width="360" Text="{x:Bind ViewModel.S.LocalFermionPath, Mode=TwoWay}" PlaceholderText="optional" />
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <!-- ============================ AUDIO -->
                <TextBlock Text="AUDIO" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <controls:SettingRow Header="Mute only the dialogue channels" Description="Vocals-only mode: rebuild the surround mix with the centre and bleed channels silenced where the words are.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.MuteVocalsOnly, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Keep the original audio" Description="Add the untouched track as a second audio stream.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.KeepOriginalAudio, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Keep the source codec" Description="Re-encode the muted track with the source codec and bitrate instead of AAC.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.ForceSameAudioEncoding, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <!-- ============================ FILES -->
                <TextBlock Text="FILES" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <controls:SettingRow Header="Preferred language" Description="Used to pick the audio and subtitle track (ISO 639-2).">
                            <ComboBox MinWidth="120" ItemsSource="{x:Bind ViewModel.Languages}" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Skip files with no filtered words" Description="Leaves the file alone instead of writing an identical copy.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.SkipMediaNoSwearing, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Skip files that look processed" Description="Ignores files whose name already ends with the affix.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.SkipAlreadyProcessed, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Send originals to the Recycle Bin" Description="Only after the output passed validation. The Recycle Bin, never a permanent delete.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.DeleteOriginalFiles, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Always generate subtitles" Description="Tick Generate for every new file, even when a subtitle already exists.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.AlwaysGenerateSubtitles, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Always re-decode" Description="Ignore the saved transcripts and transcribe again.">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.S.AlwaysOverwriteSubtitles, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                        </controls:SettingRow>
                    </StackPanel>
                </Border>

                <!-- ============================ TOOLS -->
                <TextBlock Text="TOOLS" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <controls:SettingRow Header="Installed tools" Description="FFmpeg, Docker, the Phonon engine and subloader status.">
                            <Button Content="Open Tools" Click="OpenTools_Click" />
                        </controls:SettingRow>

                        <controls:SettingRow Header="Version" Description="Cinema Guard 2.">
                            <TextBlock Text="{x:Bind ViewModel.Version}" Style="{StaticResource MutedStyle}" />
                        </controls:SettingRow>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Save bar -->
        <Border
            Grid.Row="2"
            Padding="0,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="SaveStatus" Style="{StaticResource MutedStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Reset to recommended" Click="Reset_Click" />
                    <Button Content="Save settings" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
