<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Cinema_Guard.Controls.SettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,11" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="HeaderText" Text="{x:Bind Header, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock x:Name="DescriptionText" Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Hovering the control shows what it does; a control with its own tooltip shows that one instead. -->
        <ContentPresenter
            Grid.Column="1"
            Content="{x:Bind Body, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right" />
    </Grid>
</UserControl>
