<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file, with every other file in the release folder, to the IIS folder that serves
  https://wavebit.dev/software/cinemaguard/ (any folder outside the site's wwwroot will do).

  IIS refuses files whose extension it does not know, which makes Velopack's .nupkg packages a 404.
  The MIME map below fixes that. The Cache-Control header keeps the version list fresh: without it,
  a client that checked once may keep seeing the old releases.win.json for hours after a release.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- remove first: a server that already has the entry fails the map otherwise -->
      <remove fileExtension=".nupkg" />
      <mimeMap fileExtension=".nupkg" mimeType="application/octet-stream" />
      <remove fileExtension=".zip" />
      <mimeMap fileExtension=".zip" mimeType="application/zip" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="no-cache" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <directoryBrowse enabled="false" />
  </system.webServer>

  <system.web>
    <!-- large packages: IIS' default request limit is 30 MB -->
    <httpRuntime maxRequestLength="1048576" executionTimeout="3600" />
  </system.web>
</configuration>
